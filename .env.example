# ============================================================
# RBAgriScan ENV CONFIG
# Hinglish: API keys, SMTP, DB credentials aur security secrets
# yahan environment variables ke through aate hain. Real .env ko GitHub par upload mat karo.
# ============================================================
SECRET_KEY=generate-a-long-random-secret
ADMIN_EMAIL=
ADMIN_PASSWORD=

# MySQL database connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=smart_crop_ai

# Optional: send real "forgot password" reset emails via SMTP.
# If left unset, the reset link is shown directly on the confirmation page
# instead (useful for local testing / before you've set up an email account).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# Broad plant identification (recommended)
PLANTNET_API_KEY=your-plantnet-api-key
PLANTNET_PROJECT=all
PLANTNET_MIN_CONFIDENCE=0.45

# Optional AI disease analysis + multilingual farmer assistant
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_VERIFY_LOCAL=false

# Optional: set to a higher value only if you want stricter plant acceptance.
# Pl@ntNet scores are 0..1; 0.35-0.45 is a practical demo range.
# PLANTNET_MIN_CONFIDENCE=0.40

# Security / limits
MAX_UPLOAD_MB=8
APP_RATE_LIMIT_PER_MINUTE=60

# Local development only. Never enable debug on a public server (remote code execution risk).
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
# Set true behind HTTPS (Render sets this automatically)
FORCE_HTTPS=false

# Optional: future satellite/drone imagery provider (none = "not configured yet", nothing is faked)
IMAGERY_PROVIDER=none
